"""
입찰 데이터 관리 시스템 (QDBT) — 공통 설정 [템플릿]

────────────────────────────────────────────────────────────
이 파일은 config.py 템플릿입니다.

▸ 기존 환경(맥북 등 config.py가 이미 있는 곳): 이 템플릿은 무시하세요.
  완전본을 풀어도 기존 config.py는 그대로 보존됩니다.

▸ 새 환경에 처음 설치: 이 파일을 config.py로 복사한 뒤,
  아래 [필수 수정] 항목을 채우고 실행하세요.

    cp src/config.py.template src/config.py
    # 이후 src/config.py를 열어 값 수정

주의: config.py에는 API 키 등 기밀이 들어가므로
      git/공유에서 제외하세요(.gitignore에 이미 포함).
────────────────────────────────────────────────────────────
"""
import os
from pathlib import Path

# ── 경로 (수정 불필요, 자동 계산) ─────────────────────────
ROOT = Path(__file__).parent.parent.resolve()

# 데이터 저장 위치 — 기본값 그대로 두면 프로젝트 내 data/ 사용
DB_PATH     = ROOT / "data" / "qdbt.db"          # SQLite DB 파일
UPLOAD_DIR  = ROOT / "data" / "uploads"          # 업로드 원본 견적서
EXTRACT_DIR = ROOT / "data" / "extractions"      # 추출 결과 JSON

# 데이터 디렉터리 자동 생성
for d in [UPLOAD_DIR, EXTRACT_DIR]:
    d.mkdir(parents=True, exist_ok=True)

# ── [필수 수정] LLM API ───────────────────────────────────
# API 키는 두 가지 방법으로 설정할 수 있습니다.
#   1) (권장) 로그인 후 웹 UI의 '내 프로필 / API 키'에서 사용자별 설정
#      → 이 경우 아래 ANTHROPIC_API_KEY는 비워 두어도 됩니다.
#   2) 환경변수로 전역 설정: export ANTHROPIC_API_KEY="sk-..."
#
# 사내 폐쇄망(게이트웨이) 사용 시에는 웹 UI의 프로필에서
# 제공자·base_url·SSL 검증 여부를 지정하세요(사용자별 저장).
ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
LLM_MODEL         = os.environ.get("LLM_MODEL", "claude-sonnet-4-20250514")

# ── 업로드 제약 ───────────────────────────────────────────
MAX_UPLOAD_MB      = 50
ALLOWED_EXTENSIONS = {".xlsx", ".pdf", ".docx"}

# ── 권한 역할 ─────────────────────────────────────────────
ROLES = ["admin", "manager", "viewer"]

# ── 버전 표기 ─────────────────────────────────────────────
# 완전본 적용 후 이 값을 현재 버전으로 맞추세요.
VERSION = "0.9.7"
STATUS  = "test"

# ────────────────────────────────────────────────────────────
# [참고] 첫 실행 안내
#   1) 의존성 설치:   pip install -r requirements.txt
#   2) 관리자 비밀번호: export ADMIN_PASSWORD="원하는-비밀번호"
#      (미설정 시 첫 실행에서 임시값 'changeme!' 사용 — 로그인 후 반드시 변경)
#   3) 세션 시크릿:   export SECRET_KEY="무작위-긴-문자열"  (운영 시 필수)
#   4) 실행:          python main.py   →  http://localhost:5000
# ────────────────────────────────────────────────────────────
